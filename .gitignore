# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Local show media (keep out of git)
shows/*
!shows/.gitkeep

# Local vendor binaries / wheels (under repo, never commit)
tools/
*.whl
*.zip

# Scratch / machine dumps — never leave in workspace root
*.log
__scratch__/
.local/
**/raw/ops/

# Secrets / machine config
.env
config.local.yaml
*.local.yaml

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
